{
  "name": "@apps/backend",
  "version": "1.0.0",
  "description": "Moringa Products e-commerce backend built with AdonisJS v7, Prisma and PostgreSQL.",
  "author": "Karan Patel <karanj707mern@gmail.com>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#controllers/*": [
      "./app/controllers/*.ts",
      "./app/controllers/*"
    ],
    "#services/*": [
      "./app/services/*.ts",
      "./app/services/*"
    ],
    "#middleware/*": [
      "./app/middleware/*.ts",
      "./app/middleware/*"
    ],
    "#validators/*": [
      "./app/validators/*.ts",
      "./app/validators/*"
    ],
    "#exceptions/*": [
      "./app/exceptions/*.ts",
      "./app/exceptions/*"
    ],
    "#providers/*": [
      "./app/providers/*.ts",
      "./app/providers/*"
    ],
    "#lib/*": [
      "./app/lib/*.ts",
      "./app/lib/*"
    ],
    "#contracts/*": [
      "./app/contracts/*.ts",
      "./app/contracts/*"
    ],
    "#start/*": [
      "./start/*.ts",
      "./start/*"
    ],
    "#config/*": [
      "./config/*.ts",
      "./config/*"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && node ace build",
    "start": "node build/bin/server.js",
    "dev": "node ace serve --watch",
    "serve": "node ace serve",
    "console": "node ace repl",
    "prisma:generate": "prisma generate",
    "prisma:backup": "bash prisma/scripts/db-backup.sh",
    "prisma:migrate:dev:safe": "bash prisma/scripts/migrate-with-backup.sh",
    "seed:email-templates": "ts-node prisma/seed_email_templates.ts",
    "orders:backfill-legacy": "ts-node prisma/backfill_legacy_orders.ts",
    "convert-webp": "ts-node scripts/convert_images_to_webp.ts",
    "reset-admin-pass": "ts-node scripts/reset_admin_password.ts",
    "storage:migrate": "node scripts/migrate-images-to-cloudinary.js",
    "storage:migrate:dry-run": "node scripts/migrate-images-to-cloudinary.js --dry-run",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
    "lint": "eslint . --ext=ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf build .tmp .temp"
  },
  "dependencies": {
    "@adonisjs/bodyparser": "^11.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/logger": "^7.0.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@vinejs/vine": "^3.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.3",
    "cloudinary": "^2.10.0",
    "cookie": "^1.0.2",
    "geoip-lite": "^2.0.3",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "svg-captcha": "^1.4.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/eslint-config": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@socket.io/redis-adapter": "^8.0.0",
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^1.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.7.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.0.0",
    "@types/pino": "^7.0.0",
    "eslint": "^9.0.0",
    "node-cron": "^4.1.0",
    "prettier": "^3.3.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0"
  }
}
